{
  "manifest_version": 3,
  "name": "Resurrect Pages",
  "description": "Resurrect dead pages, by finding their ghosts.",
  "version": "10",
  "homepage_url": "https://github.com/arantius/resurrect-pages",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/page-16.png",
    "32": "icons/page-32.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "tabs",
    "activeTab"
  ]
}
