  CONTROL "",IDC_EDT_NAME,"Edit",WS_CHILDWINDOW|WS_VISIBLE|WS_TABSTOP|ES_AUTOHSCROLL,7,20,211,12,WS_EX_CLIENTEDGE

  CONTROL "OK",1,"Button",WS_CHILDWINDOW|WS_VISIBLE|WS_GROUP|WS_TABSTOP,107,52,53,14,WS_EX_NOPARENTNOTIFY
  CONTROL "Cancel",2,"Button",WS_CHILDWINDOW|WS_VISIBLE|WS_TABSTOP,165,52,53,14,WS_EX_NOPARENTNOTIFY
